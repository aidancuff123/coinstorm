[Unit]
Description=Coinstorm coin toss simulator (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=tv1109
Group=tv1109
WorkingDirectory=/home/tv1109/projects/coinstorm
Environment=COINSTORM_DB=/home/tv1109/projects/coinstorm/coinstorm.db
# One worker only: background-job state lives in process memory.
ExecStart=/home/tv1109/projects/coinstorm/.venv/bin/uvicorn --factory app.main:create_app \
    --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --no-server-header
Restart=on-failure
RestartSec=3
# A max-size run peaks around 70 MB; cap well below RAM so a bug can't OOM the VM.
MemoryMax=512M
MemorySwapMax=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/tv1109/projects/coinstorm

[Install]
WantedBy=multi-user.target
